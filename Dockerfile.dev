FROM node:20-alpine

WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install all dependencies
RUN pnpm install

# Expose Vite dev server port
EXPOSE 5173

# Command will be overridden by docker-compose
CMD ["pnpm", "run", "dev", "--", "--host"]
