@startuml Diagrama_de_Actividades_Eliminar_Impuesto

title Activity Diagram - Delete a Tax

|#LightBlue|User|
|#LightGreen|System|

|User|
start
:Click the delete (trash)\nicon on the tax row;

|System|
:Show confirmation modal\n"Are you sure you want to delete this tax?";

|User|
if (Does the user\nconfirm the deletion?) then (no)
  :Click "Cancel";
  |System|
  :Close the modal\nwithout changes;
  stop
else (yes)
  :Click "Delete" / "Confirm";
endif

|System|
:Remove the tax\nfrom the table;
:Recalculate the tax totals;
:Recalculate the net income\nand affected financial ratios;
:Close the modal;

|User|
:View the updated table\nwithout the deleted tax;
stop

@enduml
